{
  "name": "alyssdj",
  "productName": "AlyssDJ",
  "version": "0.2.0",
  "private": true,
  "description": "AlyssDJ: DJ de dos decks con YouTube Music Premium y música local — un software de AlystechPY, por Alejandro Ramírez",
  "main": "main/main.js",
  "scripts": {
    "postinstall": "node scripts/setup.js --soft",
    "setup": "node scripts/setup.js",
    "start": "node scripts/setup.js --soft && electron .",
    "analyze": "node main/analyze-cli.js",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "Alejandro Ramírez",
    "url": "https://github.com/alexdrgpy06"
  },
  "license": "MIT",
  "homepage": "https://github.com/alexdrgpy06/AlyssDJ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexdrgpy06/AlyssDJ.git"
  },
  "build": {
    "appId": "py.alystech.alyssdj",
    "productName": "AlyssDJ",
    "copyright": "Copyright © 2026 AlystechPY — Alejandro Ramírez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "shared/**",
      "package.json",
      "!**/*.md",
      "build/icon.png"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AlyssDJ-Setup-${version}.${ext}",
      "publisherName": "AlystechPY"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AlyssDJ"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "AlyssDJ-${version}-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "AlyssDJ-${version}.${ext}",
      "synopsis": "DJ de dos decks con YouTube Music y música local",
      "description": "AlyssDJ: DJ de dos decks con YouTube Music Premium y música local",
      "maintainer": "Alejandro Ramírez <alexdrg06@gmail.com>",
      "vendor": "AlystechPY"
    },
    "extraMetadata": {
      "main": "main/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "alexdrgpy06",
      "repo": "AlyssDJ",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "desktopName": "alyssdj.desktop"
}
